
<!doctype html>
<html lang="id">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#07090f">
<title>NEXORA HD v2 — Video Quality Lab</title>
<style>
:root{color-scheme:dark;--bg:#07090f;--panel:#131827;--line:#303750;--text:#f4f7ff;--muted:#a4aec8;--cyan:#65e7ff;--green:#8bffbf;--purple:#9e86ff}
*{box-sizing:border-box}
body{margin:0;min-height:100vh;background:radial-gradient(ellipse at 12% 0%,#325bbe3d,transparent 40%),radial-gradient(ellipse at 90% 25%,#6b3ac233,transparent 38%),var(--bg);color:var(--text);font:15px/1.55 system-ui,sans-serif;padding:22px 14px 40px}
.wrap{width:min(760px,100%);margin:auto}
.top{display:flex;align-items:center;gap:12px;margin:4px 0 22px}
.logo{width:45px;height:45px;border:1px solid #ffffff2a;border-radius:15px;background:linear-gradient(145deg,#65e7ff33,#9e86ff33);display:grid;place-items:center;font-weight:900;color:var(--cyan)}
h1{font-size:clamp(24px,5vw,34px);line-height:1.12;margin:0}
.sub,.desc,.hint{color:var(--muted)}
.sub{margin:5px 0 0;font-size:13px}
.pill{display:inline-flex;color:var(--green);border:1px solid #8bffbf40;padding:5px 10px;border-radius:999px;font-size:11px;margin-bottom:12px}
.card{border:1px solid var(--line);background:linear-gradient(145deg,#1a2036e0,#0c0f19e8);border-radius:22px;padding:19px;margin:13px 0;box-shadow:0 16px 45px #0003}
h2{font-size:17px;margin:0 0 5px}
.desc{font-size:13px;margin:0 0 15px}
.drop{border:1px dashed #65e7ff70;border-radius:17px;background:#65e7ff08;padding:22px 15px;text-align:center}
.file-icon{font-size:30px}
input[type=file]{display:none}
.btn{border:0;border-radius:13px;padding:12px 15px;background:linear-gradient(100deg,var(--cyan),var(--purple));color:#071018;font-weight:850;font-size:14px;cursor:pointer;display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:45px;text-decoration:none}
.btn.secondary{background:#ffffff0b;border:1px solid var(--line);color:var(--text)}
.btn:disabled{opacity:.42;cursor:not-allowed}
.actions{display:flex;gap:9px;flex-wrap:wrap;margin-top:13px}
.hint{font-size:12px;margin-top:10px}
.metrics{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin-top:14px}
.metric{border:1px solid #ffffff12;background:#ffffff06;border-radius:14px;padding:12px;min-width:0}
.label{font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.7px}
.value{font-size:18px;font-weight:800;overflow-wrap:anywhere;margin-top:3px}
.small{font-size:11px;color:var(--muted)}
.status{border-radius:13px;padding:12px 13px;background:#65e7ff0c;border:1px solid #65e7ff2b;color:#d8f8ff;font-size:13px;margin-top:13px}
.steps,.checklist{display:grid;gap:10px}
.step{display:grid;grid-template-columns:32px 1fr;gap:11px}
.num{width:30px;height:30px;border-radius:10px;background:#9e86ff1b;border:1px solid #9e86ff4c;color:#c9bcff;display:grid;place-items:center;font-weight:850}
.step strong{display:block;font-size:14px}
.step p{margin:0;color:var(--muted);font-size:13px}
.check{display:flex;gap:10px;align-items:flex-start;font-size:13px}
.check input{accent-color:var(--cyan);margin-top:4px}
.warn{border-color:#ffca7a35;background:#ffca7a09;color:#ffe5b7}
footer{text-align:center;color:#75809d;font-size:11px;padding:18px 8px}
.hidden{display:none!important}
@media(min-width:600px){.metrics{grid-template-columns:repeat(4,minmax(0,1fr))}.card{padding:22px}}
</style>
</head>
<body>
<main class="wrap">
<header class="top">
<div class="logo">N</div>
<div><h1>NEXORA <span style="color:var(--cyan)">HD v2</span></h1><p class="sub">Video Quality Lab · Your Tools. Your Power.</p></div>
</header>

<div class="pill">● PROTOTIPE V2 · VIDEO ANALYZER</div>

<section class="card">
<h2>01 / Smart Video Analyzer</h2>
<p class="desc">Cek resolusi, durasi, ukuran file, dan perkiraan bitrate video sebelum upload.</p>
<div class="drop">
<div class="file-icon">◈</div>
<strong id="pickTitle">Pilih video dari Galeri atau folder</strong>
<div class="hint">Analisis berjalan di browser HP lu.</div>
<div class="actions" style="justify-content:center">
<label class="btn" for="videoFile">＋ Pilih Video</label>
<input id="videoFile" type="file" accept="video/*">
</div>
</div>
<div id="metrics" class="metrics hidden">
<div class="metric"><div class="label">Resolusi</div><div class="value" id="resolution">—</div><div class="small" id="resHint"></div></div>
<div class="metric"><div class="label">Durasi</div><div class="value" id="duration">—</div><div class="small">Panjang video</div></div>
<div class="metric"><div class="label">Ukuran file</div><div class="value" id="size">—</div><div class="small">Ukuran asli</div></div>
<div class="metric"><div class="label">Bitrate rata-rata*</div><div class="value" id="bitrate">—</div><div class="small">Estimasi</div></div>
</div>
<div id="analysis" class="status hidden" aria-live="polite"></div>
<div class="actions">
<button id="downloadBtn" class="btn secondary" disabled>↓ Download File Asli</button>
<button id="studioBtn" class="btn">Buka TikTok Studio ↗</button>
</div>
<p class="hint">Download opsional. Lu bisa langsung pilih video asli dari Galeri atau folder ekspor.</p>
</section>

<section class="card">
<h2>02 / Original Quality Protection</h2>
<p class="desc">NEXORA tidak mengubah resolusi atau melakukan encode ulang.</p>
<div class="status">✓ File dianalisis di browser. Tombol download menyimpan file yang sama, bukan versi yang ditajamkan.</div>
<p class="hint">*Bitrate adalah perkiraan total berdasarkan ukuran file dan durasi, bukan pembacaan bitrate video yang akurat.</p>
</section>

<section class="card">
<h2>03 / TikTok Upload Guide</h2>
<p class="desc">Checklist supaya lu bisa memeriksa kualitas video sebelum dan sesudah upload.</p>
<div class="checklist">
<label class="check"><input type="checkbox"><span>Gunakan file video asli, bukan salinan yang sudah dikompres aplikasi chat.</span></label>
<label class="check"><input type="checkbox"><span>Aktifkan opsi kualitas tinggi atau Upload HD jika tersedia.</span></label>
<label class="check"><input type="checkbox"><span>Gunakan koneksi internet yang stabil.</span></label>
<label class="check"><input type="checkbox"><span>Tunggu pemrosesan video selesai sebelum mengecek hasil.</span></label>
<label class="check"><input type="checkbox"><span>Periksa apakah penghemat data membatasi kualitas pemutaran.</span></label>
<label class="check"><input type="checkbox"><span>Bandingkan hasil di perangkat atau koneksi lain.</span></label>
</div>
<div class="status warn">Catatan: TikTok tetap bisa mengompres video. NEXORA tidak bisa menjamin hasil upload selalu tajam.</div>
</section>

<section class="card">
<h2>04 / Tes yang Adil</h2>
<div class="steps">
<div class="step"><div class="num">1</div><div><strong>Cek file</strong><p>Pilih video dan catat resolusi serta ukuran file.</p></div></div>
<div class="step"><div class="num">2</div><div><strong>Upload file yang sama</strong><p>Pilih video asli langsung dari Galeri atau folder ekspor di TikTok Studio.</p></div></div>
<div class="step"><div class="num">3</div><div><strong>Periksa hasil</strong><p>Tunggu pemrosesan lalu bandingkan detailnya dengan video di Galeri.</p></div></div>
</div>
</section>
<footer>NEXORA HD v2 · Video Quality Lab</footer>
</main>

<script>
(() => {
const input = document.getElementById('videoFile');
const metrics = document.getElementById('metrics');
const analysis = document.getElementById('analysis');
const downloadBtn = document.getElementById('downloadBtn');
let currentFile = null;
let objectUrl = null;

const fmtSize = bytes => bytes < 1048576
? (bytes / 1024).toFixed(0) + ' KB'
: (bytes / 1048576).toFixed(2) + ' MB';

const fmtDuration = sec => {
if (!Number.isFinite(sec)) return 'Tidak terbaca';
return Math.floor(sec / 60) + ':' + String(Math.floor(sec % 60)).padStart(2, '0');
};

const fmtRate = bps => bps >= 1000000
? (bps / 1000000).toFixed(2) + ' Mbps'
: (bps / 1000).toFixed(0) + ' kbps';

input.addEventListener('change', () => {
const file = input.files && input.files[0];
if (!file) return;
currentFile = file;
downloadBtn.disabled = false;
document.getElementById('pickTitle').textContent = file.name;

if (objectUrl) URL.revokeObjectURL(objectUrl);
objectUrl = URL.createObjectURL(file);

const video = document.createElement('video');
video.preload = 'metadata';
video.muted = true;
video.playsInline = true;

video.onloadedmetadata = () => {
const w = video.videoWidth, h = video.videoHeight, dur = video.duration;
document.getElementById('resolution').textContent = w && h ? `${w} × ${h}` : 'Tidak terbaca';
document.getElementById('resHint').textContent = h >= 2160 ? '4K / UHD' : h >= 1080 ? 'Full HD atau lebih' : h >= 720 ? 'HD' : 'Di bawah HD';
document.getElementById('duration').textContent = fmtDuration(dur);
document.getElementById('size').textContent = fmtSize(file.size);
document.getElementById('bitrate').textContent = dur > 0 ? fmtRate(file.size * 8 / dur) : '—';
metrics.classList.remove('hidden');

let notes = [];
if (w >= 1920 && h >= 1080) notes.push('Resolusi terdeteksi Full HD atau lebih.');
else notes.push('Resolusi di bawah 1920×1080 atau tidak terbaca. Cek pengaturan ekspor video.');
if (file.size * 8 / Math.max(dur, 1) < 3000000) notes.push('Perkiraan bitrate relatif rendah; ini bukan patokan mutlak.');
else notes.push('Perkiraan bitrate tercatat. Bitrate tinggi tidak menjamin hasil TikTok tajam.');
notes.push('NEXORA tidak mengubah video. TikTok tetap bisa melakukan kompresi.');
analysis.textContent = notes.join(' ');
analysis.classList.remove('hidden');
URL.revokeObjectURL(objectUrl);
objectUrl = null;
};

video.onerror = () => {
metrics.classList.remove('hidden');
analysis.textContent = 'Metadata video tidak bisa dibaca browser ini. File asli tetap bisa diunduh.';
analysis.classList.remove('hidden');
};

video.src = objectUrl;
});

downloadBtn.addEventListener('click', () => {
if (!currentFile) return;
const url = URL.createObjectURL(currentFile);
const a = document.createElement('a');
a.href = url;
a.download = currentFile.name || 'nexora-original-video';
document.body.appendChild(a);
a.click();
a.remove();
setTimeout(() => URL.revokeObjectURL(url), 1500);
});

document.getElementById('studioBtn').addEventListener('click', () => {
window.open('https://www.tiktok.com/tiktokstudio', '_blank', 'noopener,noreferrer');
});
})();
</script>
</body>
</html>
